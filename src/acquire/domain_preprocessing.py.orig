MIN_TECH_HITS = 2

# ── stage 0: document quality / register gate ────────────────────────────────
# german-commons is dominated (by TOKENS) by 19th-century Fraktur-OCR journals
# whose orthography ("dafs", "fiber", "grofs") and OCR noise are nothing like the
